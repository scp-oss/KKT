# Password for the web UI (upload / settings / dashboard).
ADMIN_PASSWORD=change-me

# Port the service listens on (also used for the Docker port mapping).
PORT=8080

# Alternative to PORT: a full "host:port" bind address, e.g. 127.0.0.1:8080.
# Overrides PORT when set. Leave unset unless you need to bind a specific
# interface.
#LISTEN_ADDR=:8080

# Path to the SQLite database file.
DB_PATH=data/kkt.db

# Set to true only once this service is actually served over HTTPS (directly
# or behind a TLS-terminating reverse proxy). Leave false for plain HTTP -
# browsers silently drop a Secure cookie over HTTP, which makes login look
# like it does nothing (you keep getting bounced back to the password page).
COOKIE_SECURE=false
